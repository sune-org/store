[{"id":"61ah7v4","name":"Your Own Store","pinned":false,"avatar":"","url":"gh://sune-org/store/tutorials/store-tutorial.sune","updatedAt":1788221453041,"settings":{"model":"","temperature":"","top_p":"","top_k":"","frequency_penalty":"","repetition_penalty":"","min_p":"","top_a":"","verbosity":"","reasoning_effort":"default","system_prompt":"","html":"Creating your own Sune store is easy. <br><br>\nFirst step: ensure your GitHub Token (PAT) is in the API section. Give it all the permissions if you don't know what you're doing. \nBottom left -> open settings -> go to API tab and put Github Token.\n<br><br>\nEvery store is a github repo but there is a template. Go to this url and create a repo from this template. It'll be your store:\n\nhttps://github.com/sune-org/StoreTemplate\n<br><br>\nNow create a new sune (it'll be your store), then go to the main Marketplace sune, copy the HTML and put it in the HTML of your store.\n\nThen edit CATALOG_URL var in the code to point to the generated catalog in your store repo.\n\n<br><br>\nNow you are setup. In order to upload your sunes to the repo, you put the path in the top of sune settings, and click the upload icon. This would be path to your store + pick any name for the file like mysune.sune\n\n<br><br>\n\nExample path: gh://sune-org/store/mysune.sune","extension_html":"<sune src='https://raw.githubusercontent.com/sune-org/store/refs/heads/main/sync.sune' private></sune>","hide_composer":false,"include_thoughts":false,"img_output":false,"aspect_ratio":"1:1","image_size":"1K","ignore_master_prompt":false,"json_output":false,"json_schema":""}}]